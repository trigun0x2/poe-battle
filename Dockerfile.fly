# Single-image deploy for Fly.io: builds the data pool and the web client,
# then runs the Fastify server, which serves the SPA from the same origin.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* tsconfig.base.json ./
COPY packages/sim/package.json packages/sim/
COPY packages/data/package.json packages/data/
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
RUN npm install --no-audit --no-fund
COPY packages ./packages
COPY apps ./apps
RUN npm run build --workspace @exile/data \
 && npm run build --workspace @exile/web

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/package.json /app/package-lock.json* /app/tsconfig.base.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/server ./apps/server
COPY --from=build /app/apps/web/dist ./apps/web/dist
EXPOSE 8787
CMD ["npm", "run", "start", "--workspace", "@exile/server"]
